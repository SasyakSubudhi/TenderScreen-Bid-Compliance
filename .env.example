# Run python scripts/configure.py to create a local .env automatically.
# Provider addresses and identifiers are runtime-only values, never commit .env.
STORE_MODE=redis
REDIS_URL=
PROVIDER_URL=
PROVIDER_MODE=stub
MODEL_ID=
PROVIDER_API_KEY=
API_TOKEN=
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
PROMPT_VERSION=v2
STUB_DELAY=0.5
FAULT_PROVIDER=0
CALL_TIMEOUT=4
RUN_TIMEOUT=45
MAX_STEPS=12
MAX_TOOLS=10
RATE_LIMIT=60
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=

# Optional local neural embedding provider and model-container bootstrap
API_PORT=8000
EMBEDDING_PROVIDER=hash
EMBEDDING_URL=
EMBEDDING_MODEL_ID=
EMBEDDING_TIMEOUT=30
MODEL_BASE_URL=
MODEL_CACHE_PATH=model-cache
RETRIEVAL_CACHE=1
LOG_PASSAGES=0
OMP_NUM_THREADS=1
