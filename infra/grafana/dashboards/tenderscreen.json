{
  "title": "TenderScreen operations",
  "uid": "tenderscreen",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Run p95 seconds",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pipeline_run_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Run p50 seconds",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(pipeline_run_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Completed runs per second",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "rate(pipeline_completed_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Availability",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Agent failure rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(agent_tasks_total{outcome=\"failure\"}[5m])) / clamp_min(sum(rate(agent_tasks_total[5m])),0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent success rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(agent)(rate(agent_tasks_total{outcome=\"success\"}[5m])) / clamp_min(sum by(agent)(rate(agent_tasks_total[5m])),0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Agent steps per task",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(agent)(rate(agent_steps_total[5m])) / clamp_min(sum by(agent)(rate(agent_tasks_total[5m])),0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Agent tools per task",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(agent)(rate(agent_tools_total[5m])) / clamp_min(sum by(agent)(rate(agent_tasks_total[5m])),0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Agent retry rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(agent)(rate(agent_retries_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Worker uptime seconds",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "agent_uptime_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Container CPU",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(name)(rate(container_cpu_usage_seconds_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Container memory bytes",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Step p95 seconds",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(agent,step,le)(rate(agent_step_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Prompt and completion tokens",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(agent,kind)(increase(agent_tokens_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Known provider cost USD",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(agent)(increase(agent_cost_usd_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Container availability",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "container_running",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Redis memory bytes",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tenderscreen-prometheus"
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "refId": "A"
        }
      ]
    }
  ]
}